[14.258791, "o", "\u001b[34m╭─\u001b[0m\u001b[34m────────────────────────────────────────\u001b[0m\u001b[34m Tracing Status \u001b[0m\u001b[34m────────────────────────────────────────\u001b[0m\u001b[34m─╮\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                                  \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m  Info: Tracing is disabled.                                                                      \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                                  \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m  To enable tracing, do any one of these:                                                         \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m  • Set tracing=True in your Crew/Flow code                                                       \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m  • Set CREWAI_TRACING_ENABLED=true in your project's .env file                                   \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m  • Run: crewai traces enable                                                                     \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                                  \u001b[34m│\u001b[0m\r\n\u001b[34m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
